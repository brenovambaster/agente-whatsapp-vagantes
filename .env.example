# ---------- Claude (Agent SDK) ----------
# API key, ou deixe vazio se o Claude Code já está logado nesta máquina.
ANTHROPIC_API_KEY=
# Modelo e esforço. Vazio = padrão do Claude Code. Para economizar: CLAUDE_MODEL=sonnet (ou haiku) e CLAUDE_EFFORT=low.
CLAUDE_MODEL=
CLAUDE_EFFORT=

# ---------- API do Vagantes ----------
# Sem barra no final. Para testar use a HOMOLOGAÇÃO, nunca a produção.
VAGANTES_API=https://vagantesmoc.com/api
# Recomendado: login de um usuário ADMIN. O serviço chama POST /api/authenticate (Basic Auth)
# e renova o JWT sozinho antes de expirar (ele dura 1 hora por padrão).
VAGANTES_ADMIN_EMAIL=
VAGANTES_ADMIN_SENHA=
# Alternativa: um JWT fixo de ADMIN. Para de funcionar quando expira. É ignorado se o e-mail e a senha estiverem preenchidos.
VAGANTES_TOKEN=

# ---------- WhatsApp: Evolution API ----------
EVOLUTION_URL=http://localhost:8080
EVOLUTION_INSTANCE=vagantes
# apikey da instância (ou a global). Não reutilize como WEBHOOK_SECRET.
EVOLUTION_API_KEY=

# Segredo do webhook. Configure o gateway para mandá-lo no cabeçalho X-Webhook-Secret (preferível)
# ou no fim da URL (http://host:porta/webhook/SEGREDO), que acaba aparecendo nos logs do gateway.
WEBHOOK_SECRET=

# Quem pode mandar reservas: número só com dígitos (DDI+DDD+número), separados por vírgula.
# Se o gateway mostrar um identificador interno (terminado em @lid) em vez do número, acrescente-o.
ALLOWED_NUMBERS=5538999999999

# Grupos atendidos (ids terminados em @g.us), separados por vírgula. Vazio = só conversas privadas.
# No grupo, o remetente também precisa estar em ALLOWED_NUMBERS, e a resposta vai para o próprio grupo.
ALLOWED_GROUPS=

# ---------- Servidor do webhook ----------
# 127.0.0.1 se a Evolution roda na mesma máquina; 0.0.0.0 se ela roda no Docker ou em outro host.
HOST=127.0.0.1
PORT=3000
